# Backend API
# - Local dev: http://localhost:8000 (simulator / same machine)
# - Physical device on Wi‑Fi: http://<your-PC-LAN-IPv4>:8000
# - TestFlight / Play internal / beta testers: https://your-staging-api.example.com (NOT localhost)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase (from Supabase dashboard — match the project used by the beta backend)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: use mock API for UI-only testing
# EXPO_PUBLIC_USE_MOCK_API=true

# Closed beta — set to true for friend / TestFlight builds (Google + Sign in later only; no Subscription row; beta Paywall copy).
# Leave unset/false for full sign-up options during local dev.
# EXPO_PUBLIC_CLOSED_BETA=true

# Ship checklist: docs/BETA_READINESS.md · device QA: docs/CLOSED_BETA_E2E_CHECKLIST.md
